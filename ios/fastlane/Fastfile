default_platform(:ios)

platform :ios do
  desc "Build & upload to TestFlight"
  lane :beta do
    api_key_id = ENV.fetch("APPSTORE_CONNECT_API_KEY_ID")
    api_key_issuer = ENV.fetch("APPSTORE_CONNECT_API_ISSUER_ID")
    api_key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{api_key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: api_key_id,
      issuer_id: api_key_issuer,
      key_filepath: api_key_path,
      duration: 1200,
      in_house: false
    )

    next_build = (latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dlddu.PocketAide",
      initial_build_number: 0
    ) + 1).to_s

    [
      "PocketAide/Info-Release.plist",
      "PocketAideKeyboard/Info.plist",
      "PocketAideWidget/Info.plist"
    ].each do |path|
      set_info_plist_value(path: path, key: "CFBundleVersion", value: next_build)
    end

    gym(
      project: "PocketAide.xcodeproj",
      scheme: "PocketAide",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "PocketAide.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.dlddu.PocketAide" => ENV.fetch("PROFILE_NAME_MAIN"),
          "com.dlddu.PocketAide.Keyboard" => ENV.fetch("PROFILE_NAME_KEYBOARD"),
          "com.dlddu.PocketAide.Widget" => ENV.fetch("PROFILE_NAME_WIDGET")
        }
      }
    )

    pilot(
      api_key: api_key,
      ipa: "build/PocketAide.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Wait for the latest TestFlight build to finish processing and set its changelog"
  lane :update_changelog do
    api_key_id = ENV.fetch("APPSTORE_CONNECT_API_KEY_ID")
    api_key_issuer = ENV.fetch("APPSTORE_CONNECT_API_ISSUER_ID")
    api_key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{api_key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: api_key_id,
      issuer_id: api_key_issuer,
      key_filepath: api_key_path,
      duration: 1200,
      in_house: false
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.dlddu.PocketAide"
    ).to_s

    changelog = ENV["TESTFLIGHT_CHANGELOG"]
    changelog = "Automated build from PR ##{ENV['GITHUB_RUN_NUMBER'] || 'local'}" if changelog.nil? || changelog.empty?

    pilot(
      api_key: api_key,
      app_identifier: "com.dlddu.PocketAide",
      app_platform: "ios",
      build_number: build_number,
      changelog: changelog,
      distribute_only: true,
      skip_submission: true,
      distribute_external: false
    )
  end

  desc "Verify the TestFlight changelog of the latest build matches the expected value"
  lane :verify_changelog do
    api_key_id = ENV.fetch("APPSTORE_CONNECT_API_KEY_ID")
    api_key_issuer = ENV.fetch("APPSTORE_CONNECT_API_ISSUER_ID")
    api_key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{api_key_id}.p8")

    app_store_connect_api_key(
      key_id: api_key_id,
      issuer_id: api_key_issuer,
      key_filepath: api_key_path,
      duration: 1200,
      in_house: false
    )

    expected = ENV["TESTFLIGHT_CHANGELOG"]
    expected = "Automated build from PR ##{ENV['GITHUB_RUN_NUMBER'] || 'local'}" if expected.nil? || expected.empty?

    app = Spaceship::ConnectAPI::App.find("com.dlddu.PocketAide")
    UI.user_error!("App com.dlddu.PocketAide not found in App Store Connect") if app.nil?

    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      sort: "-uploadedDate",
      limit: 1
    ).first
    UI.user_error!("No builds found for com.dlddu.PocketAide") if build.nil?

    localizations = []
    attempts = 12
    attempts.times do |i|
      localizations = build.get_beta_build_localizations
      break if localizations.any? && localizations.all? { |loc| loc.whats_new == expected }
      UI.message("TestFlight changelog not yet visible for build #{build.version} (attempt #{i + 1}/#{attempts}), waiting 15s...")
      sleep(15) unless i == attempts - 1
    end
    UI.user_error!("No beta build localizations for build #{build.version} after #{attempts * 15}s") if localizations.empty?

    mismatched = localizations.reject { |loc| loc.whats_new == expected }
    if mismatched.any?
      mismatched.each do |loc|
        UI.error("Locale #{loc.locale} whatsNew differs from expected:")
        UI.error("  expected: #{expected.inspect}")
        UI.error("  actual:   #{loc.whats_new.inspect}")
      end
      UI.user_error!("TestFlight changelog verification failed")
    end

    UI.success("TestFlight changelog verified for build #{build.version} across #{localizations.count} locale(s)")
  end
end
